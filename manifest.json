{
  "manifest_version": 2,
  "name": "GronkhTV+ VLC-Bridge",
  "version": "0.1.10",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "description": "Fügt gronkh.tv einen 'In VLC öffnen'-Button hinzu, damit Streams für Hintergrundwiedergabe an VLC übergeben werden können.",
  "browser_specific_settings": {
    "gecko": {
      "id": "gronkhtv-companion@litschi.space",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "https://gronkh.tv/*",
    "https://backend.gronkh.tv/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://gronkh.tv/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
